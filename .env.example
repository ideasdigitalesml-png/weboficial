# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: full bypass of Row Level Security. Server-only, never
# prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain this app is served from (tenant landings are subdomains of it)
NEXT_PUBLIC_ROOT_DOMAIN=example.com

# Public URL of this deployment (used to build Mercado Pago back_urls, etc.)
NEXT_PUBLIC_APP_URL=https://example.com

# Mercado Pago (developer panel > your app > Credentials / Webhooks)
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Dev/sandbox only. Must never be set in production -- when unset, checkout
# uses the real logged-in user's email instead.
MP_TEST_PAYER_EMAIL=
