# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: full bypass of Row Level Security. Server-only, never
# prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain this app is served from (tenant landings are subdomains of it)
NEXT_PUBLIC_ROOT_DOMAIN=example.com

# Public URL of this deployment (used to build Mercado Pago back_urls, etc.)
NEXT_PUBLIC_APP_URL=https://example.com

# Mercado Pago (developer panel > your app > Credentials / Webhooks)
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Dev/sandbox only. Must never be set in production -- when unset, checkout
# uses the real logged-in user's email instead.
MP_TEST_PAYER_EMAIL=

# ResellerClub (domain reseller API) -- httpapi.com reseller panel
RESELLERCLUB_RESELLER_ID=your-reseller-id
RESELLERCLUB_API_KEY=your-resellerclub-api-key

# Fixie static-IP proxy (Vercel integration). Every ResellerClub API call
# (src/lib/resellerclub/client.ts) is routed through this proxy -- see
# src/lib/resellerclub/fixie-proxy.ts -- because ResellerClub only accepts
# requests from allowlisted IPs and Vercel's outbound IP is not static.
# No other outbound call (Mercado Pago, Supabase, Vercel API) uses this.
FIXIE_URL=http://fixie-user:fixie-token@criterium.usefixie.com:80

# Custom domain pricing (.com only). ResellerClub's reseller-price.json
# already returns the cost in ARS for this account -- precio = costo_ars *
# (1 + MARGEN_COM/100). No USD/FX conversion involved.
MARGEN_COM=100

# Vercel API token (Account Settings > Tokens) -- lets the app call
# POST /v10/projects/{id}/domains to wire a purchased custom domain's DNS.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

