# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: full bypass of Row Level Security. Server-only, never
# prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain this app is served from (tenant landings are subdomains of it)
NEXT_PUBLIC_ROOT_DOMAIN=example.com

# Public URL of this deployment (used to build Mercado Pago back_urls, etc.)
NEXT_PUBLIC_APP_URL=https://example.com

# Mercado Pago (developer panel > your app > Credentials / Webhooks)
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Dev/sandbox only. Must never be set in production -- when unset, checkout
# uses the real logged-in user's email instead.
MP_TEST_PAYER_EMAIL=

# ResellerClub (domain reseller API) -- httpapi.com reseller panel
RESELLERCLUB_RESELLER_ID=your-reseller-id
RESELLERCLUB_API_KEY=your-resellerclub-api-key

# Custom domain pricing: costo_resellerclub_usd * (1 + margen/100) * DOLAR_OFICIAL
DOLAR_OFICIAL=1700
MARGEN_COM=150
MARGEN_COM_AR=250

# Vercel API token (Account Settings > Tokens) -- lets the app call
# POST /v10/projects/{id}/domains to wire a purchased custom domain's DNS.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# Feature-flags the dashboard's "Mi dominio" purchase UI (search/buy). The
# API routes and webhook logic exist regardless of this flag -- it only
# gates whether the dashboard shows a working search or a "Próximamente"
# banner. Off until ResellerClub's IP allowlist + the .com.ar product-key
# are sorted out (see DomainSection.tsx).
DOMAIN_PURCHASE_ENABLED=false
